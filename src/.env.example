# MySQL credentials for LPAEZsis API (BlueHosting / local PHP)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lpaezsis
DB_USER=tu_usuario_mysql
DB_PASS=tu_password_mysql
DB_CHARSET=utf8mb4

# Uploads (relative URL served by the site)
UPLOAD_URL_PREFIX=/img/uploads
# Absolute path on server, e.g. /home/USER/public_html/prueba1.lpaezsis.cl/img/uploads
# Leave empty to auto-detect common locations
UPLOAD_DIR=

ADMIN_SESSION_HOURS=12
APP_DEBUG=0
